  "lessons": [
    {
      "id": "u08-l1",
      "title": "Days",
      "goal": "Name the days of the week, say what day it is, and say what you do on a day every week.",
      "notes": [
        {
          "id": "u08-l1-n1",
          "title": "Days are small letters",
          "body": "Days of the week are written with a small letter in French, unlike English: *lundi* (Monday), *mardi* (Tuesday). To say what day it is, use **c'est**. *Aujourd'hui* means *today*, *demain* means *tomorrow* and *hier* means *yesterday*. For yesterday, use **c'était** (it was): *hier, c'était dimanche*.",
          "examples": [
            {
              "fr": "Aujourd'hui, c'est lundi.",
              "en": "Today is Monday."
            },
            {
              "fr": "Demain, c'est mardi.",
              "en": "Tomorrow is Tuesday."
            },
            {
              "fr": "Hier, c'était dimanche.",
              "en": "Yesterday was Sunday."
            }
          ]
        },
        {
          "id": "u08-l1-n2",
          "title": "Le + day means every",
          "body": "Put **le** before a day to mean *on that day, every week*. *Le samedi* means *on Saturdays*. Without **le**, the day means one particular day, such as *lundi* for this coming Monday. The **le** stays the same for every day.",
          "examples": [
            {
              "fr": "Le samedi, je travaille.",
              "en": "On Saturdays, I work."
            },
            {
              "fr": "Le dimanche, je regarde des films.",
              "en": "On Sundays, I watch films."
            },
            {
              "fr": "Le mercredi, j'écoute de la musique.",
              "en": "On Wednesdays, I listen to music."
            }
          ]
        }
      ],
