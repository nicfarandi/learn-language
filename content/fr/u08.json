    {
      "id": "u08-l4",
      "title": "My day",
      "goal": "Say when you do things in the morning, afternoon, evening or night, and say early or late.",
      "notes": [
        {
          "id": "u08-l4-n1",
          "title": "Parts of the day",
          "body": "**le matin** (morning), **l'après-midi** (afternoon), **le soir** (evening) and **la nuit** (night) are the parts of the day. Put **le** or **la** before them to mean *in the*: *le matin* means *in the morning*. Before a vowel, **le** becomes **l'**, as in *l'après-midi*.",
          "examples": [
            {
              "fr": "Le matin, je travaille.",
              "en": "In the morning, I work."
            },
            {
              "fr": "L'après-midi, j'écoute de la musique.",
              "en": "In the afternoon, I listen to music."
            },
            {
              "fr": "Le soir, je regarde des films.",
              "en": "In the evening, I watch films."
            }
          ]
        },
        {
          "id": "u08-l4-n2",
          "title": "Early and late",
          "body": "**tôt** means *early* and **tard** means *late*. They come after the verb: *je travaille tôt*. You also use them alone: *il est tard* means *it's late*.",
          "examples": [
            {
              "fr": "Je travaille tôt le matin.",
              "en": "I work early in the morning."
            },
            {
              "fr": "Je mange tard le soir.",
              "en": "I eat late in the evening."
            },
            {
              "fr": "Il est tard, madame.",
              "en": "It's late, madam."
            }
          ]
        }
      ],
      "words": [
        {
          "id": "u08-l4-w1",
          "fr": "le matin",
          "en": "in the morning / morning",
          "tip": "Le matin = in the morning."
        },
        {
          "id": "u08-l4-w2",
          "fr": "l'après-midi",
          "en": "afternoon",
          "tip": "Un après-midi, but l' before the word."
