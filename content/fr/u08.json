    {
      "id": "u08-l3",
      "title": "The time",
      "goal": "Tell the time to the quarter hour, and say midi and minuit.",
      "notes": [
        {
          "id": "u08-l3-n1",
          "title": "Il est and the hour",
          "body": "Say the time with **il est** + the hour. Use **une heure** for one o'clock, and **heures** for all the others: *deux heures*, *trois heures*. Midday and midnight have no **heure**: *il est midi*, *il est minuit*.",
          "examples": [
            {
              "fr": "Il est une heure.",
              "en": "It's one o'clock."
            },
            {
              "fr": "Il est trois heures.",
              "en": "It's three o'clock."
            },
            {
              "fr": "Il est midi.",
              "en": "It's noon."
            }
          ]
        },
        {
          "id": "u08-l3-n2",
          "title": "Quarters and halves",
          "body": "**et quart** means *quarter past*, and **et demie** means *half past*. After the half hour, count to the next hour with **moins le quart** (*quarter to*). So *cinq heures moins le quart* is 4:45.",
          "examples": [
            {
              "fr": "Il est trois heures et quart.",
              "en": "It's quarter past three."
            },
            {
              "fr": "Il est quatre heures et demie.",
              "en": "It's half past four."
            },
            {
              "fr": "Il est cinq heures moins le quart.",
              "en": "It's quarter to five."
            }
          ]
        }
      ],
