    {
      "id": "u09-l3",
      "title": "Going to",
      "goal": "Say what you are going to do soon, using aller and a verb.",
      "notes": [
        {
          "id": "u09-l3-n1",
          "title": "Aller + a verb: going to",
          "body": "To talk about the near future, use **aller** and a verb in its basic form (the *-er* form). *Je vais manger* means *I am going to eat*. Only **aller** changes; the verb after it stays the same.",
          "examples": [
            {
              "fr": "Je vais manger ce soir.",
              "en": "I am going to eat tonight."
            },
            {
              "fr": "Nous allons travailler demain.",
              "en": "We are going to work tomorrow."
            },
            {
              "fr": "Tu vas parler à Paul ?",
              "en": "Are you going to talk to Paul?"
            }
          ]
        },
        {
          "id": "u09-l3-n2",
          "title": "Ce soir, bientôt and goodbyes",
          "body": "**Ce soir** means *tonight*, and **ce week-end** means *this weekend*. **Bientôt** means *soon*. When you leave someone, say **à bientôt** (*see you soon*) or **à ce soir** (*see you tonight*).",
          "examples": [
            {
              "fr": "Ce week-end, je vais au parc.",
              "en": "This weekend, I am going to the park."
            },
            {
              "fr": "Nous allons manger bientôt.",
              "en": "We are going to eat soon."
            },
            {
              "fr": "À bientôt, Paul !",
              "en": "See you soon, Paul!"
            }
          ]
        }
      ],
