    {
      "id": "u02-l3",
      "title": "Nationalities",
      "goal": "Say where someone is from, for a man or a woman.",
      "notes": [
        {
          "id": "u02-l3-n1",
          "title": "No capital letter",
          "body": "In French, nationality words are **not** capitalised, even though English capitalises them. Use them after **être**: *je suis français*. Do not add *un* or *une* before them.",
          "examples": [
            {
              "fr": "Je suis français.",
              "en": "I'm French."
            },
            {
              "fr": "Paul est américain.",
              "en": "Paul is American."
            },
            {
              "fr": "Nous sommes italiens.",
              "en": "We are Italian."
            }
          ]
        },
        {
          "id": "u02-l3-n2",
          "title": "Add -e for a woman",
          "body": "For a woman, add **-e**: **français** becomes **française**. Some endings change more: **anglais** becomes **anglaise**, **américain** becomes **américaine**, and **australien** becomes **australienne** (double **n**). Add **-s** for more than one, as in **espagnoles**.",
          "examples": [
            {
              "fr": "Léa est anglaise.",
              "en": "Léa is English."
            },
            {
              "fr": "Elle est australienne.",
              "en": "She's Australian."
            },
            {
              "fr": "Elles sont espagnoles.",
              "en": "They are Spanish. (women)"
            }
          ]
        }
      ],
      "words": [
