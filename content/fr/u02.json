    {
      "id": "u02-l2",
      "title": "To be",
      "goal": "Say who you are and how you feel, using être.",
      "notes": [
        {
          "id": "u02-l2-n1",
          "title": "Être: to be",
          "body": "**être** means *to be*. Learn its forms as a set: **je suis**, **tu es**, **il / elle est**, **nous sommes**, **vous êtes**, **ils / elles sont**. Use it to say who you are and how you feel. Do not add *un* or *une* before a job or study word: *je suis étudiant*.",
          "examples": [
            {
              "fr": "Je suis étudiant.",
              "en": "I'm a student."
            },
            {
              "fr": "Tu es content ?",
              "en": "Are you happy?"
            },
            {
              "fr": "Nous sommes contents.",
              "en": "We're happy."
            }
          ]
        },
        {
          "id": "u02-l2-n2",
          "title": "Man or woman?",
          "body": "For a woman, add **-e** to the word: **content** becomes **contente**, **fatigué** becomes **fatiguée**, **étudiant** becomes **étudiante**. Add **-s** for more than one. The spelling changes, so write it carefully.",
          "examples": [
            {
              "fr": "Je suis étudiante.",
              "en": "I'm a student. (woman)"
            },
            {
              "fr": "Léa est fatiguée.",
              "en": "Léa is tired."
            },
            {
              "fr": "Elles sont contentes.",
              "en": "They are happy. (women)"
            }
          ]
        }
      ],
      "words": [
        {
          "id": "u02-l2-w1",
          "fr": "être",
          "en": "to be",
          "tip": "Irregular. Learn the forms as a set."
