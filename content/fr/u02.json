    {
      "id": "u02-l4",
      "title": "Not",
      "goal": "Say no and not, and agree with someone using aussi.",
      "notes": [
        {
          "id": "u02-l4-n1",
          "title": "Ne … pas: not",
          "body": "To say **not**, put **ne** before the verb and **pas** after it: *je **ne** suis **pas** français*. Before a vowel, **ne** becomes **n'**: *il **n'**est pas*. The two words wrap around the verb.",
          "examples": [
            {
              "fr": "Je ne suis pas français.",
              "en": "I'm not French."
            },
            {
              "fr": "Tu n'es pas content ?",
              "en": "You're not happy?"
            },
            {
              "fr": "Elle n'est pas espagnole.",
              "en": "She's not Spanish."
            }
          ]
        },
        {
          "id": "u02-l4-n2",
          "title": "Oui, non, aussi",
          "body": "**Oui** means *yes* and **non** means *no*. **aussi** means *too*, and **moi aussi** means *me too*. Use it to agree with someone who says how they feel.",
          "examples": [
            {
              "fr": "Oui, je suis étudiant.",
              "en": "Yes, I'm a student."
            },
            {
              "fr": "Non, merci.",
              "en": "No, thanks."
            },
            {
              "fr": "Je suis content. Moi aussi !",
              "en": "I'm happy. Me too!"
            }
          ]
        }
      ],
      "words": [
        {
          "id": "u02-l4-w1",
          "fr": "ne … pas",
          "en": "not",
          "tip": "Wraps around the verb: je ne suis pas."
