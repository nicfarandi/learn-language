{
  "id": "u02",
  "number": 2,
  "title": "Who I am",
  "summary": "Say who you and others are, how you feel, where you are from, and say no or not. Your first real sentences with être.",
  "canDo": [
    "Use je, tu, il, elle, nous, vous, ils and elles to talk about myself and others.",
    "Say I am, you are, he or she is, using être, and say how I feel.",
    "Say my nationality, for a man or a woman.",
    "Say no and not, and agree with someone using aussi."
  ],
  "lessons": [
    {
      "id": "u02-l1",
      "title": "People words",
      "goal": "Say I, you, he, she, we and they, and say other people's names.",
      "notes": [
        {
          "id": "u02-l1-n1",
          "title": "I, you and we",
          "body": "**je** is *I*, **tu** and **vous** are *you* (Unit 1), and **nous** is *we*. In everyday talk the French often say **on** for *we*: *on va bien* = we're fine. In writing, use **nous**.",
          "examples": [
            {
              "fr": "Je m'appelle Léa.",
              "en": "My name is Léa."
            },
            {
              "fr": "Nous, ça va bien.",
              "en": "We're doing well."
            },
            {
              "fr": "On va bien, merci.",
              "en": "We're fine, thanks. (casual)"
            }
          ]
        },
        {
          "id": "u02-l1-n2",
          "title": "He, she and they",
          "body": "**il** is *he* and **elle** is *she*. For *they*, use **ils** for men or a mixed group, and **elles** for women only. With them, *je m'appelle* becomes **il s'appelle**, **elle s'appelle**, **ils s'appellent** (the *-ent* is silent).",
          "examples": [
            {
              "fr": "Il s'appelle Paul.",
              "en": "His name is Paul."
            },
            {
              "fr": "Elle s'appelle Léa.",
              "en": "Her name is Léa."
            },
            {
              "fr": "Ils s'appellent Paul et Marc.",
              "en": "Their names are Paul and Marc."
            }
          ]
        }
      ],
      "words": [
        {
          "id": "u02-l1-w1",
          "fr": "je",
