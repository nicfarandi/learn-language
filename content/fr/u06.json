    {
      "id": "u06-l3",
      "title": "My, your, his or her",
      "goal": "Say my, your, his or her with the right form for the thing owned.",
      "notes": [
        {
          "id": "u06-l3-n1",
          "title": "The thing owned decides",
          "body": "**mon** is *my* before a masculine noun, **ma** before a feminine noun, and **mes** before more than one. **ton / ta / tes** mean *your* (to a friend) and **son / sa / ses** mean *his* or *her*. The word agrees with the **thing owned**, not with the owner: *ma mère* is *my mother*, whoever you are.",
          "examples": [
            {
              "fr": "Mon père a un chat.",
              "en": "My father has a cat."
            },
            {
              "fr": "Ma mère a une voiture.",
              "en": "My mother has a car."
            },
            {
              "fr": "Mes parents ont un chien.",
              "en": "My parents have a dog."
            }
          ]
        },
        {
          "id": "u06-l3-n2",
          "title": "Mon before a vowel",
          "body": "Before a feminine noun that starts with a vowel sound, use **mon** instead of **ma**, so it sounds smooth: *mon amie*, not *ma amie*. The same goes for **ton** and **son** before *amie*: *ton amie*, *son amie*.",
          "examples": [
            {
              "fr": "Mon amie a un chat.",
              "en": "My friend has a cat. (a woman)"
            },
            {
              "fr": "Son amie a un chien.",
              "en": "His or her friend has a dog. (a woman)"
            },
            {
              "fr": "Ton amie a une voiture, Paul ?",
              "en": "Your friend has a car, Paul? (a woman)"
            }
          ]
        }
      ],
      "words": [
        {
          "id": "u06-l3-w1",
          "fr": "mon",
          "en": "my (m)",
          "tip": "Before a masculine noun, or a feminine one starting with a vowel: mon amie."
        },
        {
          "id": "u06-l3-w2",
          "fr": "ma",
          "en": "my (f)",
          "tip": "Before a feminine noun: ma mère."
        },
        {
