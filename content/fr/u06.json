    {
      "id": "u06-l2",
      "title": "Family",
      "goal": "Name your family and friends, with the right article for each.",
      "notes": [
        {
          "id": "u06-l2-n1",
          "title": "Le or la with family",
          "body": "Family words have a gender, like every noun. **le** goes with a man or a boy (*le père*, *le frère*), and **la** with a woman or a girl (*la mère*, *la sœur*). Learn each word with its article.",
          "examples": [
            {
              "fr": "Paul a un frère.",
              "en": "Paul has a brother."
            },
            {
              "fr": "Léa a une sœur.",
              "en": "Léa has a sister."
            },
            {
              "fr": "Le père et la mère.",
              "en": "The father and the mother."
            }
          ]
        },
        {
          "id": "u06-l2-n2",
          "title": "Un, une, des and les",
          "body": "**un** and **une** mean *a*, as before: *un ami* (a male friend), *une amie* (a female friend). **des** means *some*, and **les** means *the* for more than one: *les parents*. *Un enfant* works for a boy or a girl.",
          "examples": [
            {
              "fr": "Marc a un ami.",
              "en": "Marc has a friend. (a man)"
            },
            {
              "fr": "Ils ont des enfants.",
              "en": "They have children."
            },
            {
              "fr": "Les parents ont une voiture.",
              "en": "The parents have a car."
            }
          ]
        }
      ],
      "words": [
        {
          "id": "u06-l2-w1",
          "fr": "la mère",
