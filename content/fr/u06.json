    {
      "id": "u06-l4",
      "title": "Describing people",
      "goal": "Describe a person or a pet, with the adjective in the right place and form.",
      "notes": [
        {
          "id": "u06-l4-n1",
          "title": "Adjectives agree",
          "body": "An adjective changes to match the person or thing: add **-e** for a woman (*gentil* becomes *gentille*) and **-s** for more than one (*gentils*). Most adjectives come after *être* or after the noun: *un chien gentil* (a kind dog).",
          "examples": [
            {
              "fr": "Mon chien est gentil.",
              "en": "My dog is kind."
            },
            {
              "fr": "Ma mère est gentille.",
              "en": "My mother is kind."
            },
            {
              "fr": "Mes parents sont gentils.",
              "en": "My parents are kind."
            }
          ]
        },
        {
          "id": "u06-l4-n2",
          "title": "Short adjectives go before",
          "body": "Some common adjectives go **before** the noun: **grand**, **petit**, **jeune**, **vieux** and **beau** (beauty, age and size). Say *un petit chat* (a small cat), not *un chat petit*. For a woman, *beau* becomes *belle* and *vieux* becomes *vieille*.",
          "examples": [
            {
              "fr": "Un petit chat !",
              "en": "A small cat!"
            },
            {
              "fr": "Un beau chien, monsieur !",
              "en": "A handsome dog, sir!"
            },
            {
              "fr": "Une grande voiture !",
              "en": "A big car!"
            }
          ]
        }
      ],
      "words": [
        {
