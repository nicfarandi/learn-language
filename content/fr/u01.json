    {
      "id": "u01-l4",
      "title": "How are you?",
      "goal": "Ask how someone is, answer, and choose tu or vous.",
      "notes": [
        {
          "id": "u01-l4-n1",
          "title": "Tu or vous?",
          "body": "French has two words for \"you\". **tu** is for one friend, family member, child or pet. **vous** is for a stranger, someone older, or someone at work, and for more than one person. When unsure, use **vous**.",
          "examples": [
            {
              "fr": "Salut, Paul, et toi ?",
              "en": "Hi, Paul, and you?"
            },
            {
              "fr": "Bonjour, madame, et vous ?",
              "en": "Hello, madam, and you?"
            }
          ]
        },
        {
          "id": "u01-l4-n2",
          "title": "Ça va ?",
          "body": "**Ça va ?** is a question when your voice goes up, and an answer when it goes down. Reply with **très bien**, **bien** or **pas mal** (not bad).",
          "examples": [
            {
              "fr": "Ça va ? — Ça va bien, merci.",
              "en": "How are you? — I'm well, thanks."
            },
            {
              "fr": "Très bien, et vous ?",
              "en": "Very well, and you?"
            },
            {
              "fr": "Pas mal, et toi ?",
              "en": "Not bad, and you?"
            }
          ]
        }
      ],
