{
  "id": "u01",
  "number": 1,
  "title": "Hello",
  "summary": "Greet people, say please and thank you, give your name and ask how someone is. Your first real French words.",
  "canDo": [
    "Greet someone politely or casually, at any time of day.",
    "Say please, thank you, sorry and excuse me.",
    "Give my name and ask someone's name.",
    "Ask how someone is, and answer, using tu or vous."
  ],
  "lessons": [
    {
      "id": "u01-l1",
      "title": "Greetings",
      "goal": "Greet someone politely or casually, at any time of day, and say goodbye.",
      "notes": [
        {
          "id": "u01-l1-n1",
          "title": "Bonjour or salut?",
          "body": "**Bonjour** is polite and works with anyone: a shop assistant, a stranger, your boss. **Salut** is casual, for friends, family and people your age. **Au revoir** means goodbye to anyone. When unsure, say *bonjour*.",
          "examples": [
            {
              "fr": "Bonjour, madame.",
              "en": "Hello, madam."
            },
            {
              "fr": "Salut !",
              "en": "Hi!"
            },
            {
              "fr": "Au revoir, monsieur.",
              "en": "Goodbye, sir."
            }
          ]
        },
        {
          "id": "u01-l1-n2",
          "title": "Bonjour or bonsoir?",
          "body": "**Bonjour** works until early evening. **Bonsoir** is for after about 6 pm. In France, adding *madame* or *monsieur* is extra polite.",
          "examples": [
            {
              "fr": "Bonsoir, madame.",
              "en": "Good evening, madam."
            },
            {
              "fr": "Bonjour, monsieur.",
              "en": "Hello, sir."
            }
          ]
        }
      ],
      "words": [
        {
          "id": "u01-l1-w1",
          "fr": "bonjour",
          "en": "hello / good morning",
          "tip": "Literally \"good day\". Use it until early evening."
        },
        {
          "id": "u01-l1-w2",
          "fr": "bonsoir",
          "en": "good evening",
          "tip": "From about 6 pm."
        },
        {
          "id": "u01-l1-w3",
          "fr": "salut",
          "en": "hi / bye",
          "tip": "Casual. Works for hello and goodbye."
        },
        {
          "id": "u01-l1-w4",
          "fr": "au revoir",
          "en": "goodbye",
          "tip": "Literally \"until seeing again\"."
        },
        {
          "id": "u01-l1-w5",
          "fr": "madame",
          "en": "madam / Mrs"
        },
        {
          "id": "u01-l1-w6",
          "fr": "monsieur",
          "en": "sir / Mr",
          "tip": "Sounds like \"muh-syuh\". The n and r are silent."
        }
