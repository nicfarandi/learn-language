    {
      "id": "u01-l3",
      "title": "My name is…",
      "goal": "Give your name and ask someone's name, casually or politely.",
      "notes": [
        {
          "id": "u01-l3-n1",
          "title": "Je m'appelle",
          "body": "French says \"I call myself\": **je m'appelle** Léa means \"my name is Léa\". To ask, use **Comment tu t'appelles ?** (casual) or **Comment vous appelez-vous ?** (polite). Learn these as whole phrases for now.",
          "examples": [
            {
              "fr": "Je m'appelle Paul.",
              "en": "My name is Paul."
            },
            {
              "fr": "Comment tu t'appelles ?",
              "en": "What's your name? (casual)"
            },
            {
              "fr": "Comment vous appelez-vous ?",
              "en": "What's your name? (polite)"
            }
          ]
        },
        {
          "id": "u01-l3-n2",
          "title": "Enchanté or enchantée?",
          "body": "A man says **enchanté**, a woman says **enchantée**. Both sound exactly the same. The extra **-e** for a woman is a pattern you will meet again and again.",
          "examples": [
            {
              "fr": "Enchantée, je m'appelle Léa.",
              "en": "Nice to meet you, I'm Léa."
            },
            {
              "fr": "Enchanté, je m'appelle Paul.",
              "en": "Nice to meet you, I'm Paul."
            }
          ]
        }
      ],
      "words": [
