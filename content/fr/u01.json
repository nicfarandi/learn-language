    {
      "id": "u01-l2",
      "title": "Polite words",
      "goal": "Say please, thank you, sorry and excuse me in the right way.",
      "notes": [
        {
          "id": "u01-l2-n1",
          "title": "Two ways to say please",
          "body": "**s'il vous plaît** is polite, or used with more than one person. **s'il te plaît** is for a friend or family member. Both mean \"if it pleases you\". In texts you will see *svp* and *stp*.",
          "examples": [
            {
              "fr": "Monsieur, s'il vous plaît.",
              "en": "Sir, please."
            },
            {
              "fr": "Paul, s'il te plaît.",
              "en": "Paul, please."
            }
          ]
        },
        {
          "id": "u01-l2-n2",
          "title": "Sorry and excuse me",
          "body": "**Pardon** is a quick \"sorry\" when you bump into someone, or \"Pardon?\" when you did not hear. **Excusez-moi** gets someone's attention before you ask something.",
          "examples": [
            {
              "fr": "Pardon !",
              "en": "Sorry!"
            },
            {
              "fr": "Pardon, madame ?",
              "en": "Sorry, madam?"
            },
            {
              "fr": "Excusez-moi, monsieur.",
              "en": "Excuse me, sir."
            }
          ]
        }
      ],
      "words": [
