    {
      "id": "u05-l3",
      "title": "Twenty-one to sixty-nine",
      "goal": "Count from twenty-one to sixty-nine, in tens and units.",
      "notes": [
        {
          "id": "u05-l3-n1",
          "title": "Twenty-one and the others: et un",
          "body": "**Twenty-one** is **vingt et un**, with *et* (and) before *un*. Thirty-one, forty-one and the others do the same. From 22 to 29 there is no *et*: **vingt-deux**. Before a feminine noun, *un* becomes **une**.",
          "examples": [
            {
              "fr": "Vingt et un livres, madame.",
              "en": "Twenty-one books, madam."
            },
            {
              "fr": "Vingt et une chaises, monsieur.",
              "en": "Twenty-one chairs, sir."
            },
            {
              "fr": "Trente et un stylos.",
              "en": "Thirty-one pens."
            }
          ]
        },
        {
          "id": "u05-l3-n2",
          "title": "The tens: 30, 40, 50, 60",
          "body": "**trente**, **quarante**, **cinquante** and **soixante** are the tens. Add a unit with a hyphen: *trente-deux*, *quarante-trois*. Be careful: **quarante** (forty) is not **quatre** (four).",
          "examples": [
            {
              "fr": "Trente chaises, madame.",
              "en": "Thirty chairs, madam."
            },
            {
              "fr": "Quarante-trois stylos.",
              "en": "Forty-three pens."
            },
            {
              "fr": "Soixante livres, monsieur.",
              "en": "Sixty books, sir."
            }
          ]
        }
      ],
