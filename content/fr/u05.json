    {
      "id": "u05-l4",
      "title": "Age and price",
      "goal": "Say how old I am, and ask or say how much something costs.",
      "notes": [
        {
          "id": "u05-l4-n1",
          "title": "Age: I have … years",
          "body": "In French you do not *are* your age, you **have** years. Say **j'ai** (I have), then the number, then **ans** (years). *J'ai dix ans* means *I'm ten*. To ask, say **Quel âge ?** (How old?).",
          "examples": [
            {
              "fr": "J'ai dix ans.",
              "en": "I'm ten."
            },
            {
              "fr": "Quel âge ? J'ai trente ans.",
              "en": "How old? I'm thirty."
            },
            {
              "fr": "J'ai quarante ans, monsieur.",
              "en": "I'm forty, sir."
            }
          ]
        },
        {
          "id": "u05-l4-n2",
          "title": "How much? Euros",
          "body": "**Ça coûte combien ?** and **Ça fait combien ?** both mean *How much is it?* The price is **le prix**. Answer with a number and **euros**. Like plural nouns, *euro* becomes *euros* after any number above one: *un euro*, *deux euros*.",
          "examples": [
            {
              "fr": "Ça coûte combien ?",
              "en": "How much does it cost?"
            },
            {
              "fr": "Ça fait cinq euros.",
              "en": "That's five euros."
            },
            {
              "fr": "Un euro, s'il vous plaît.",
              "en": "One euro, please."
            }
          ]
        }
      ],
