    {
      "id": "u04-l2",
      "title": "Eat and drink",
      "goal": "Say what you eat and drink, with manger and boire.",
      "notes": [
        {
          "id": "u04-l2-n1",
          "title": "Manger and boire",
          "body": "**Manger** (to eat) is a regular verb: *je mange*, *tu manges*, *il mange*. **Boire** (to drink) is irregular, so learn it as it is: *je bois*, *tu bois*, *il boit*. Use the subject words you already know: *je*, *tu*, *il*, *elle*.",
          "examples": [
            {
              "fr": "Je mange une pomme.",
              "en": "I eat an apple."
            },
            {
              "fr": "Tu manges le pain ?",
              "en": "Are you eating the bread?"
            },
            {
              "fr": "Il boit un café.",
              "en": "He drinks a coffee."
            }
          ]
        },
        {
          "id": "u04-l2-n2",
          "title": "The food comes after the verb",
          "body": "The food or drink comes **after** the verb, with its article: *je mange **un** croissant*. In a question, you can raise your voice at the end instead of changing the order: *Tu bois un café ?*",
          "examples": [
            {
              "fr": "Je bois un jus d'orange.",
              "en": "I drink an orange juice."
            },
            {
              "fr": "Elle mange un croissant.",
              "en": "She eats a croissant."
            },
            {
              "fr": "Tu bois un café, Paul ?",
              "en": "Are you drinking a coffee, Paul?"
            }
          ]
        }
      ],
