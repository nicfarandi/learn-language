    {
      "id": "u04-l3",
      "title": "Some food",
      "goal": "Say you eat or drink some food, and say you don't eat any.",
      "notes": [
        {
          "id": "u04-l3-n1",
          "title": "Du, de la, de l' and des",
          "body": "These mean *some*, for food you do not count. Use **du** before a masculine noun, **de la** before a feminine noun, and **de l'** before a vowel sound. For more than one thing, use **des**, as you learnt in Unit 3.",
          "examples": [
            {
              "fr": "Du pain, s'il vous plaît.",
              "en": "Some bread, please."
            },
            {
              "fr": "De la viande, madame ?",
              "en": "Some meat, madam?"
            },
            {
              "fr": "De l'eau, s'il te plaît.",
              "en": "Some water, please. (to a friend)"
            }
          ]
        },
        {
          "id": "u04-l3-n2",
          "title": "Pas de: not any",
          "body": "After **ne … pas**, *du*, *de la*, *de l'* and *des* all become just **de**. It means *not any*: *je ne mange pas **de** viande* is *I don't eat any meat*. Use this for food you do not eat or drink.",
          "examples": [
            {
              "fr": "Je ne mange pas de viande.",
              "en": "I don't eat any meat."
            },
            {
              "fr": "Tu ne bois pas de vin ?",
              "en": "Don't you drink any wine?"
            },
            {
              "fr": "Je ne bois pas de lait, merci.",
              "en": "I don't drink any milk, thanks."
            }
          ]
        }
      ],
      "words": [
        {
