  "lessons": [
    {
      "id": "u04-l1",
      "title": "Food",
      "goal": "Name common food and drink with le, la or l'.",
      "notes": [
        {
          "id": "u04-l1-n1",
          "title": "Le, la and l' with food",
          "body": "Food nouns are masculine or feminine, like every other noun. Learn each one with its article: **le** for a masculine noun, **la** for a feminine noun, and **l'** before a vowel sound. *Le pain* (bread) and *le lait* (milk) are masculine. *La pomme* (apple) is feminine.",
          "examples": [
            {
              "fr": "Le pain, s'il vous plaît.",
              "en": "Bread, please."
            },
            {
              "fr": "La pomme, monsieur ?",
              "en": "The apple, sir?"
            },
            {
              "fr": "L'eau, s'il te plaît.",
              "en": "Water, please. (to a friend)"
            }
          ]
        },
        {
          "id": "u04-l1-n2",
          "title": "Un or le?",
          "body": "Use **un** or **une** when you order or name a food: *un thé*, *une pomme*. Use **le**, **la** or **l'** when it is the one you mean, the one in front of you or the one you already know.",
          "examples": [
            {
              "fr": "Un thé, s'il vous plaît.",
              "en": "A tea, please."
            },
            {
              "fr": "Le café, Paul ? Merci !",
              "en": "The coffee, Paul? Thanks!"
            },
            {
              "fr": "Une pomme et un pain.",
              "en": "An apple and a loaf of bread."
            }
          ]
        }
      ],
