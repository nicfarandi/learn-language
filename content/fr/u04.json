    {
      "id": "u04-l4",
      "title": "At the café",
      "goal": "Order a drink politely and ask for the bill.",
      "notes": [
        {
          "id": "u04-l4-n1",
          "title": "Je voudrais",
          "body": "**Je voudrais** means *I would like*. It is the polite way to order, and it works with anyone. Say it, then the thing you want, with its article: *je voudrais **un** thé*. Add *s'il vous plaît* at the end.",
          "examples": [
            {
              "fr": "Je voudrais un thé, s'il vous plaît.",
              "en": "I would like a tea, please."
            },
            {
              "fr": "Je voudrais une tasse de café.",
              "en": "I would like a cup of coffee."
            },
            {
              "fr": "Je voudrais un verre d'eau, madame.",
              "en": "I would like a glass of water, madam."
            }
          ]
        },
        {
          "id": "u04-l4-n2",
          "title": "Voici and the bill",
          "body": "**Voici** means *here is* or *here are*. Say it when you put something down in front of someone. **L'addition** is the bill. Ask for it with *L'addition, s'il vous plaît*.",
          "examples": [
            {
              "fr": "Voici un thé, madame.",
              "en": "Here is a tea, madam."
            },
            {
              "fr": "Voici l'addition, monsieur.",
              "en": "Here is the bill, sir."
            },
            {
              "fr": "L'addition, s'il vous plaît !",
              "en": "The bill, please!"
            }
          ]
        }
      ],
      "words": [
