  "lessons": [
    {
      "id": "u11-l1",
      "title": "To do and make",
      "goal": "Say what you do at home with faire, using the right article for each activity.",
      "notes": [
        {
          "id": "u11-l1-n1",
          "title": "Faire: to do, to make",
          "body": "**faire** is irregular. Its stem changes: **je fais**, **tu fais**, **il / elle fait**, **nous faisons**, **vous faites**, **ils / elles font**. Learn the forms by heart, they are used all the time.",
          "examples": [
            {
              "fr": "Je fais les courses.",
              "en": "I do the shopping."
            },
            {
              "fr": "Ils font un gâteau.",
              "en": "They are baking a cake."
            },
            {
              "fr": "Vous faites la cuisine, madame ?",
              "en": "Do you cook, madam?"
            }
          ]
        },
        {
          "id": "u11-l1-n2",
          "title": "Faire and the activity",
          "body": "After **faire**, the activity has its own article: **les courses**, **la cuisine**, **le ménage**. For one thing you make, use **un** or **une**: *un gâteau*. Learn each phrase as a whole, because the article follows the activity, not the verb.",
          "examples": [
            {
              "fr": "Elle fait le ménage.",
              "en": "She does the housework."
            },
            {
              "fr": "Je fais un gâteau, Paul.",
              "en": "I'm baking a cake, Paul."
            },
            {
              "fr": "Nous faisons la cuisine ce soir.",
              "en": "We are cooking tonight."
            }
          ]
        }
      ],
