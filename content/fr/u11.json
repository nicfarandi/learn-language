    {
      "id": "u11-l2",
      "title": "Weather",
      "goal": "Describe the weather today, including rain and snow.",
      "notes": [
        {
          "id": "u11-l2-n1",
          "title": "Il fait: the weather is",
          "body": "For the weather in general, use **il fait** (*it makes*) with an adjective: **beau** (nice), **chaud** (hot) or **froid** (cold). The adjective stays masculine here, because *il* is not a person. Use **ne … pas** around *fait* to say it is not.",
          "examples": [
            {
              "fr": "Il fait beau aujourd'hui.",
              "en": "The weather is nice today."
            },
            {
              "fr": "Il fait froid, monsieur.",
              "en": "It's cold, sir."
            },
            {
              "fr": "Il ne fait pas chaud.",
              "en": "It isn't hot."
            }
          ]
        },
        {
          "id": "u11-l2-n2",
          "title": "Rain and snow",
          "body": "For rain and snow, do not use *faire*. Say **il pleut** (it is raining) and **il neige** (it is snowing) on their own, with nothing after them.",
          "examples": [
            {
              "fr": "Il pleut, Paul.",
              "en": "It's raining, Paul."
            },
            {
              "fr": "Aujourd'hui, il neige.",
              "en": "Today, it's snowing."
            },
            {
              "fr": "Il fait chaud et il pleut.",
              "en": "It's hot and it's raining."
            }
          ]
        }
      ],
      "words": [
