    {
      "id": "u11-l3",
      "title": "Hobbies",
      "goal": "Say which sports and instruments you play, and what you like reading.",
      "notes": [
        {
          "id": "u11-l3-n1",
          "title": "Jouer à: sports and games",
          "body": "Use **jouer à** for a sport or a game. **à + le** becomes **au**: *jouer au foot*, *jouer au tennis*. Conjugate **jouer** like *parler*: **je joue**, **tu joues**, **il joue**, **nous jouons**, **vous jouez**, **ils jouent**.",
          "examples": [
            {
              "fr": "Je joue au foot.",
              "en": "I play football."
            },
            {
              "fr": "Tu joues au tennis, Paul ?",
              "en": "Do you play tennis, Paul?"
            },
            {
              "fr": "Nous jouons au tennis.",
              "en": "We play tennis."
            }
          ]
        },
        {
          "id": "u11-l3-n2",
          "title": "Jouer de: instruments",
          "body": "For an instrument, use **jouer de**. **de + la** stays **de la**: *jouer de la guitare*. **de + le** becomes **du**: *jouer du piano*. It is the same article rule as *du* and *de la*.",
          "examples": [
            {
              "fr": "Il joue de la guitare.",
              "en": "He plays the guitar."
            },
            {
              "fr": "Elle joue du piano, Léa ?",
              "en": "Does she play the piano, Léa?"
            },
            {
              "fr": "Je joue de la guitare, et vous ?",
              "en": "I play the guitar, and you?"
            }
          ]
        }
      ],
