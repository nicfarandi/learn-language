    {
      "id": "u11-l4",
      "title": "How often",
      "goal": "Say how often you do something, and say that you never do it.",
      "notes": [
        {
          "id": "u11-l4-n1",
          "title": "Ne … jamais: never",
          "body": "**ne … jamais** means *never*. It wraps the verb, like *ne … pas*: *je **ne** joue **jamais***. *Ne* goes before the verb and *jamais* goes after it. Do not add *pas* as well.",
          "examples": [
            {
              "fr": "Il ne fait jamais la cuisine.",
              "en": "He never cooks."
            },
            {
              "fr": "Nous ne jouons jamais au foot.",
              "en": "We never play football."
            },
            {
              "fr": "Je ne fais jamais les courses.",
              "en": "I never do the shopping."
            }
          ]
        },
        {
          "id": "u11-l4-n2",
          "title": "Where the frequency word goes",
          "body": "Put **toujours**, **souvent**, **parfois** and **rarement** after the verb: *je fais souvent*. You can also start the sentence with them, followed by a comma: *Parfois, il pleut.* **Une fois par semaine** (once a week) goes at the end of the sentence.",
          "examples": [
            {
              "fr": "Je fais toujours le ménage.",
              "en": "I always do the housework."
            },
            {
              "fr": "Parfois, il pleut.",
              "en": "Sometimes it rains."
            },
            {
              "fr": "Elle fait du sport une fois par semaine.",
              "en": "She does sport once a week."
            }
          ]
        }
      ],
