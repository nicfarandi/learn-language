    {
      "id": "u07-l2",
      "title": "More verbs",
      "goal": "Say where you live and work, and what you watch, listen to and like.",
      "notes": [
        {
          "id": "u07-l2-n1",
          "title": "Same pattern, new verbs",
          "body": "**habiter** (to live), **travailler** (to work), **aimer** (to like), **écouter** (to listen to) and **regarder** (to watch) follow the **parler** pattern. Drop **-er**, then add the ending. In *je travaille*, the **ill** sounds like the *y* in *yes*.",
          "examples": [
            {
              "fr": "Je travaille bien.",
              "en": "I work well."
            },
            {
              "fr": "Elle habite ici.",
              "en": "She lives here."
            },
            {
              "fr": "Tu regardes ça ?",
              "en": "Are you watching that?"
            }
          ]
        },
        {
          "id": "u07-l2-n2",
          "title": "J' before a vowel",
          "body": "**je** becomes **j'** before a vowel sound or a silent **h**: *j'habite*, *j'aime*. Before a consonant, keep **je**: *je travaille*. Say *j'habite* as one smooth word, with no pause after the **j'**.",
          "examples": [
            {
              "fr": "J'habite ici.",
              "en": "I live here."
            },
            {
              "fr": "J'aime ça.",
              "en": "I like that."
            },
            {
              "fr": "Je travaille ici.",
              "en": "I work here."
            }
          ]
        }
      ],
      "words": [
