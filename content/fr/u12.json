  "lessons": [
    {
      "id": "u12-l1",
      "title": "Meeting someone",
      "goal": "Say who you are, where you live and what you do, and ask the same questions back.",
      "notes": [
        {
          "id": "u12-l1-n1",
          "title": "Where you live and work",
          "body": "Use **habiter** (to live) and **travailler** (to work) to say where you are. Put **où** (where) at the end of the question: *Vous habitez où ?* For a city, use **à**: *à Paris*.",
          "examples": [
            {
              "fr": "Tu habites où ?",
              "en": "Where do you live? (to a friend)"
            },
            {
              "fr": "J'habite à Paris.",
              "en": "I live in Paris."
            },
            {
              "fr": "Vous travaillez où ?",
              "en": "Where do you work? (polite)"
            }
          ]
        },
        {
          "id": "u12-l1-n2",
          "title": "Who you are",
          "body": "Use **je suis** (I am) to say who you are, and **vous êtes** (you are) to ask. For a woman, add an **-e** to a nationality: *français*, *française*. Jobs take no article: *je suis étudiant*, not *un étudiant*.",
          "examples": [
            {
              "fr": "Vous êtes français ?",
              "en": "Are you French? (polite)"
            },
            {
              "fr": "Je suis française.",
              "en": "I am French. (a woman)"
            },
            {
              "fr": "Je suis anglais.",
              "en": "I am English. (a man)"
            }
          ]
        }
      ],
