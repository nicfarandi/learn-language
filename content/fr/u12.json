    {
      "id": "u12-l3",
      "title": "Finding your way",
      "goal": "Ask where a place is, and understand and give simple directions.",
      "notes": [
        {
          "id": "u12-l3-n1",
          "title": "Where is it?",
          "body": "Ask **où est…?** (where is…?) followed by the place with its article: *où est la gare ?* Use **le** for a masculine place, **la** for a feminine one and **l'** before a vowel.",
          "examples": [
            {
              "fr": "Pardon, madame. Où est la gare ?",
              "en": "Sorry, madam. Where is the station?"
            },
            {
              "fr": "Où est le parc ?",
              "en": "Where is the park?"
            },
            {
              "fr": "Où est l'école ?",
              "en": "Where is the school?"
            }
          ]
        },
        {
          "id": "u12-l3-n2",
          "title": "Directions and distance",
          "body": "Use **tout droit** (straight on), **à gauche** (to the left) and **à droite** (to the right). Ask **c'est loin ?** (is it far?) and answer with **près** (near) or **loin** (far). Start the answer with **c'est**.",
          "examples": [
            {
              "fr": "La gare ? C'est tout droit.",
              "en": "The station? It's straight on."
            },
            {
              "fr": "Le parc ? C'est à gauche.",
              "en": "The park? It's on the left."
            },
            {
              "fr": "C'est loin ? Non, c'est près.",
              "en": "Is it far? No, it's near."
            }
          ]
        }
      ],
