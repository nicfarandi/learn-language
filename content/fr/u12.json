    {
      "id": "u12-l4",
      "title": "Stage 1 review",
      "goal": "Mix greetings, ordering and directions in one short conversation.",
      "notes": [
        {
          "id": "u12-l4-n1",
          "title": "Greet, ask, thank",
          "body": "Most short conversations follow the same order: **greet** first, then say who you are or ask for something, and finish with thanks and goodbye. With a stranger, use **vous**. To order politely, use **je voudrais**.",
          "examples": [
            {
              "fr": "Bonjour, madame. Je m'appelle Marc.",
              "en": "Hello, madam. My name is Marc."
            },
            {
              "fr": "Je voudrais une tasse de thé, s'il vous plaît.",
              "en": "I would like a cup of tea, please."
            },
            {
              "fr": "Merci. Au revoir, monsieur !",
              "en": "Thanks. Goodbye, sir!"
            }
          ]
        },
        {
          "id": "u12-l4-n2",
          "title": "Weather, time and likes",
          "body": "**Il fait** describes the weather: *il fait beau* (it is nice). **Il y a** means *there is*. With **aimer** (to like), use **le / la / les** before the thing you like: *j'aime le café*.",
          "examples": [
            {
              "fr": "Il fait beau aujourd'hui.",
              "en": "It's nice today."
            },
            {
              "fr": "Il y a un parc à gauche.",
              "en": "There is a park on the left."
            },
            {
              "fr": "J'aime le café.",
              "en": "I like coffee."
            }
          ]
        }
      ],
      "words": [
