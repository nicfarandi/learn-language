    {
      "id": "u12-l2",
      "title": "At the café",
      "goal": "Order a drink and a snack, ask the price, and ask for the bill.",
      "notes": [
        {
          "id": "u12-l2-n1",
          "title": "Ordering politely",
          "body": "**Je voudrais** (I would like) is the polite way to order. Follow it with a noun and its article: *un café*, *un thé*. End with **s'il vous plaît** (please). For a short order, you can say just the noun and *s'il vous plaît*.",
          "examples": [
            {
              "fr": "Je voudrais un thé, s'il vous plaît.",
              "en": "I would like a tea, please."
            },
            {
              "fr": "Un croissant, s'il vous plaît.",
              "en": "A croissant, please."
            },
            {
              "fr": "Et un croissant, s'il vous plaît.",
              "en": "And a croissant, please."
            }
          ]
        },
        {
          "id": "u12-l2-n2",
          "title": "The price and the bill",
          "body": "**Ça coûte combien ?** asks *how much is it?* Answer with a number and **euros**: *deux euros*. Ask for the bill with **l'addition**. When the waiter brings something, they say **voici** (here is) before the noun.",
          "examples": [
            {
              "fr": "Ça coûte combien ? Deux euros.",
              "en": "How much is it? Two euros."
            },
            {
              "fr": "L'addition, s'il vous plaît.",
              "en": "The bill, please."
            },
            {
              "fr": "Voici le café, monsieur.",
              "en": "Here is the coffee, sir."
            }
          ]
        }
      ],
