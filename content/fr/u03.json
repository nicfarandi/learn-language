    {
      "id": "u03-l3",
      "title": "More than one",
      "goal": "Talk about more than one thing, using des and plural nouns.",
      "notes": [
        {
          "id": "u03-l3-n1",
          "title": "Des means some",
          "body": "**des** is the plural of **un** and **une**. It means *some*, for more than one thing, without a number. The noun gets an **-s** at the end, and the **-s** is silent, so *des stylos* sounds like *des stylo*.",
          "examples": [
            {
              "fr": "Des livres, s'il vous plaît.",
              "en": "Some books, please."
            },
            {
              "fr": "Des clés, monsieur ?",
              "en": "Some keys, sir?"
            },
            {
              "fr": "Des stylos et des sacs.",
              "en": "Some pens and some bags."
            }
          ]
        },
        {
          "id": "u03-l3-n2",
          "title": "Singular and plural",
          "body": "To make a noun plural, add **-s**. The accent stays: *une clé* becomes *des clés*, and *une fenêtre* becomes *des fenêtres*. You hear the plural from the article, **des**, not from the noun.",
          "examples": [
            {
              "fr": "Une clé, Léa ? Merci !",
              "en": "A key, Léa? Thanks!"
            },
            {
              "fr": "Des clés, s'il te plaît.",
              "en": "Some keys, please. (to a friend)"
            },
            {
              "fr": "Une fenêtre, madame ?",
              "en": "A window, madam?"
            }
          ]
        }
      ],
      "words": [
