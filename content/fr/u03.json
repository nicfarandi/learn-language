    {
      "id": "u03-l4",
      "title": "What is it?",
      "goal": "Ask what something is, say what it is, and hand something over.",
      "notes": [
        {
          "id": "u03-l4-n1",
          "title": "C'est and ce sont",
          "body": "**C'est** means *it is* or *this is* for one thing. **Ce sont** means *they are* or *these are* for more than one. Use them to point at something and say what it is, followed by a noun with its article.",
          "examples": [
            {
              "fr": "C'est un livre.",
              "en": "It's a book."
            },
            {
              "fr": "C'est une table, madame.",
              "en": "It's a table, madam."
            },
            {
              "fr": "Ce sont des clés.",
              "en": "These are keys."
            }
          ]
        },
        {
          "id": "u03-l4-n2",
          "title": "Questions and handing over",
          "body": "**Qu'est-ce que c'est ?** means *What is it?* Answer it with **c'est** or **ce sont**. When you hand something to someone, say **voilà**, which means *here you are* or *there it is*.",
          "examples": [
            {
              "fr": "Qu'est-ce que c'est ? C'est une chaise.",
              "en": "What is it? It's a chair."
            },
            {
              "fr": "Voilà, monsieur.",
              "en": "Here you are, sir."
            },
            {
              "fr": "Voilà un cahier, Marc.",
              "en": "Here's a notebook, Marc."
            }
          ]
        }
      ],
      "words": [
        {
          "id": "u03-l4-w1",
          "fr": "c'est",
          "en": "it is / this is",
          "tip": "For one thing or person."
        },
        {
          "id": "u03-l4-w2",
          "fr": "ce sont",
          "en": "they are / these are",
          "tip": "For more than one."
        },
