    {
      "id": "u03-l2",
      "title": "The",
      "goal": "Name a thing with le, la, l' or les, and know when to use each.",
      "notes": [
        {
          "id": "u03-l2-n1",
          "title": "Le, la and les",
          "body": "**le** is *the* for a masculine noun, and **la** is *the* for a feminine noun. For more than one thing, use **les**, whatever the gender. Learn each noun with its article, so you know which one to use.",
          "examples": [
            {
              "fr": "Le téléphone, s'il vous plaît.",
              "en": "The phone, please."
            },
            {
              "fr": "La porte, madame ?",
              "en": "The door, madam?"
            },
            {
              "fr": "Les chaises, monsieur ?",
              "en": "The chairs, sir?"
            }
          ]
        },
        {
          "id": "u03-l2-n2",
          "title": "L' before a vowel",
          "body": "Before a vowel sound, both **le** and **la** become **l'**, joined to the noun with an apostrophe: *l'ordinateur*. You cannot hear the gender in this case, so learn the noun with its article. Never write *le ordinateur*.",
          "examples": [
            {
              "fr": "L'ordinateur, Marc ?",
              "en": "The computer, Marc?"
            },
            {
              "fr": "L'ordinateur, s'il te plaît.",
              "en": "The computer, please. (to a friend)"
            },
            {
              "fr": "Le livre et l'ordinateur.",
              "en": "The book and the computer."
            }
          ]
        }
      ],
      "words": [
        {
          "id": "u03-l2-w1",
          "fr": "le",
          "en": "the (masculine)",
          "tip": "Before a consonant: le téléphone."
        },
        {
