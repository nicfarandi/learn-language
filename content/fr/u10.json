    {
      "id": "u10-l3",
      "title": "Colours",
      "goal": "Describe the colour of a thing, and make the colour agree with the noun.",
      "notes": [
        {
          "id": "u10-l3-n1",
          "title": "The colour comes after the noun",
          "body": "Colour words come **after** the noun, as most adjectives do in French: *une table **blanche***, *un sac **noir***. To say what colour something is, use **est**: *le stylo est bleu*.",
          "examples": [
            {
              "fr": "Un sac noir, s'il te plaît.",
              "en": "A black bag, please. (to a friend)"
            },
            {
              "fr": "Une chaise rouge.",
              "en": "A red chair."
            },
            {
              "fr": "Le sac est noir, pas bleu.",
              "en": "The bag is black, not blue."
            }
          ]
        },
        {
          "id": "u10-l3-n2",
          "title": "The colour agrees",
          "body": "A colour agrees with the noun it describes. For a feminine noun, add **-e**: *blanc* becomes *blanche*, *noir* becomes *noire*, *bleu* becomes *bleue*, *vert* becomes *verte*. **rouge** does not change for a feminine noun. For more than one thing, add **-s**.",
          "examples": [
            {
              "fr": "La fenêtre est blanche.",
              "en": "The window is white."
            },
            {
              "fr": "Des chaises bleues.",
              "en": "Blue chairs."
            },
            {
              "fr": "Une chaise noire.",
              "en": "A black chair."
            }
          ]
        }
      ],
      "words": [
