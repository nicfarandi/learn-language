    {
      "id": "u10-l4",
      "title": "Where things are",
      "goal": "Say where something is, using on, under, in, in front of, behind and next to.",
      "notes": [
        {
          "id": "u10-l4-n1",
          "title": "Sur, sous, dans: on, under, in",
          "body": "**sur** means *on*, **sous** means *under* and **dans** means *in*. Each one is followed by an article: **le**, **la**, **l'** or **les**. Use them with *est* to say where something is.",
          "examples": [
            {
              "fr": "Le livre est sur la table.",
              "en": "The book is on the table."
            },
            {
              "fr": "Le chat est sous le lit.",
              "en": "The cat is under the bed."
            },
            {
              "fr": "Où est le stylo ? Dans le sac.",
              "en": "Where is the pen? In the bag."
            }
          ]
        },
        {
          "id": "u10-l4-n2",
          "title": "Devant, derrière, à côté de",
          "body": "**devant** means *in front of*, **derrière** means *behind*, and **à côté de** means *next to*. The article follows them too: *devant la porte*. With **à côté de**, the **de** joins the article, as with *à + le = au*: *à côté **du** lit* (de + le = du).",
          "examples": [
            {
              "fr": "Le lit est derrière la porte.",
              "en": "The bed is behind the door."
            },
            {
              "fr": "Le frigo est devant la fenêtre.",
              "en": "The fridge is in front of the window."
            },
            {
              "fr": "La clé est à côté du téléphone.",
              "en": "The key is next to the phone."
            }
          ]
        }
      ],
      "words": [
