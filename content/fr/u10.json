    {
      "id": "u10-l2",
      "title": "There is",
      "goal": "Say what is in a room, and what is not, using il y a.",
      "notes": [
        {
          "id": "u10-l2-n1",
          "title": "Il y a: there is, there are",
          "body": "**Il y a** means *there is* or *there are*. It never changes, for one thing or many. After it, use **un**, **une** or **des**: *il y a un lit*, *il y a des chaises*. Use it to say what is in a room.",
          "examples": [
            {
              "fr": "Il y a un lit.",
              "en": "There is a bed."
            },
            {
              "fr": "Il y a des chaises.",
              "en": "There are some chairs."
            },
            {
              "fr": "Il y a une lampe ?",
              "en": "Is there a lamp?"
            }
          ]
        },
        {
          "id": "u10-l2-n2",
          "title": "Il n'y a pas de: there isn't any",
          "body": "To say there is **no** thing, use **il n'y a pas de**. The **ne** becomes **n'** before the **y**. After *pas*, *un*, *une* and *des* all become **de**, so the article disappears: *il n'y a pas **de** lit*.",
          "examples": [
            {
              "fr": "Il n'y a pas de frigo.",
              "en": "There isn't a fridge."
            },
            {
              "fr": "Il n'y a pas de chaises.",
              "en": "There aren't any chairs."
            },
            {
              "fr": "Il n'y a pas de lampe, Paul.",
              "en": "There isn't a lamp, Paul."
            }
          ]
        }
      ],
      "words": [
        {
          "id": "u10-l2-w1",
          "fr": "il y a",
          "en": "there is / there are",
          "tip": "Never changes. Il y a un lit, il y a des chaises."
        },
