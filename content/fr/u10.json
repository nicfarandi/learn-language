  "lessons": [
    {
      "id": "u10-l1",
      "title": "Rooms",
      "goal": "Name the rooms of a home with their article, and say how big they are.",
      "notes": [
        {
          "id": "u10-l1-n1",
          "title": "Every room has an article",
          "body": "Rooms are nouns, so each one has a gender and an article: **la** for a feminine room, **le** for a masculine one. Learn the room with its article. *Salle de bains* is always feminine, because of *salle*, so it takes **la**.",
          "examples": [
            {
              "fr": "La cuisine est grande.",
              "en": "The kitchen is big."
            },
            {
              "fr": "Le salon est petit.",
              "en": "The living room is small."
            },
            {
              "fr": "Ma chambre est petite.",
              "en": "My bedroom is small."
            }
          ]
        },
        {
          "id": "u10-l1-n2",
          "title": "Plural rooms",
          "body": "To make a room plural, add **-s** and use **les**: *la chambre* becomes *les chambres*. Adjectives after a plural noun take **-s** too: *les jardins sont grands*. For *salle de bains*, only *salle* takes the **-s**: *les salles de bains*.",
          "examples": [
            {
              "fr": "Les chambres sont petites.",
              "en": "The bedrooms are small."
            },
            {
              "fr": "Les salles de bains sont grandes.",
              "en": "The bathrooms are big."
            },
            {
              "fr": "Les jardins sont grands.",
              "en": "The gardens are big."
            }
          ]
        }
      ],
      "words": [
